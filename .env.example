# Copy to `.env` and set values as needed. Repo-root `.env` is loaded by
# `transcribe._bootstrap` before workspace paths are resolved (does not override
# variables already set in the shell / Compose).
#
# HOST_* — used by docker-compose.yml for volume mount sources on the host.
# TRANSCRIBE_* — used by the app (native runs and container env in compose).

# -----------------------------------------------------------------------------
# Docker Compose: host paths for volume mounts
# -----------------------------------------------------------------------------
# Notebook projects: required for `docker compose`. Use an absolute path outside
# the git clone so wiping the repo never deletes your OCR work.
# Example: HOST_PROJECTS_DIR=/Users/you/Documents/transcribe-projects
HOST_PROJECTS_DIR=

# Optional scratch / caches under the container /data mount.
# Default: ./data (under the clone; fine for disposable scratch).
HOST_DATA_DIR=

# Scans / PDFs to import (container: /mnt/inbox, read-only in base compose).
# Example: HOST_INBOX_DIR=/Users/you/Documents/notebook-scans
HOST_INBOX_DIR=

# Export destination for markdown / plain text / transcribe.notebook JSON.
# Example: HOST_EXPORT_DIR=/Users/you/Documents/transcribe-exports
HOST_EXPORT_DIR=

# -----------------------------------------------------------------------------
# Storage & paths (native / overrides; in Docker these are usually set in compose)
# -----------------------------------------------------------------------------
TRANSCRIBE_DATA_DIR=
TRANSCRIBE_PROJECTS_DIR=
TRANSCRIBE_INBOX_DIR=
TRANSCRIBE_EXPORT_DIR=

# -----------------------------------------------------------------------------
# Ollama
# -----------------------------------------------------------------------------
# Native default: http://localhost:11434
# Docker default (compose): http://host.docker.internal:11434
TRANSCRIBE_OLLAMA_BASE_URL=

# -----------------------------------------------------------------------------
# Web bind (native launcher / container listen address)
# -----------------------------------------------------------------------------
TRANSCRIBE_HOST=
TRANSCRIBE_PORT=
# Compose published host bind (default loopback). LAN: 0.0.0.0
TRANSCRIBE_BIND_HOST=
